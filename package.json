{
  "name": "@worksbien/check-printer-engine",
  "version": "0.5.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=85 tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:stress": "node --test tests/stress.test.ts",
    "validate:gates": "node scripts/validate-gates.ts",
    "harness": "node src/cli.ts",
    "acceptance": "node harness/acceptance.ts",
    "scenarios": "node harness/scenarios.ts",
    "verify:pdf": "node scripts/verify-pdf-integrity.ts",
    "test:pdf-visual": "node scripts/verify-pdf-visuals.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
